# Lobby — shared env template (copy into app-local .env / .env.local)
# URL is public; anon keys are RLS-gated for clients.
# NEVER put SUPABASE_SERVICE_ROLE_KEY in mobile or NEXT_PUBLIC_ / EXPO_PUBLIC_ vars.

NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key

EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your_anon_key

# Server-only (backoffice / Edge Functions) — set in Vercel or Supabase secrets
# SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
