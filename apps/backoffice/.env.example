# Public (safe for browser bundle — anon key is RLS-gated)
# Copy to .env.local and fill from Dashboard → Settings → API.
# I dati di Lobby vivono nello schema `lobby` (non `public`) del progetto condiviso
# Rank AI / Mediplan / Lobby: https://mjzjracjadlybvdttgto.supabase.co
# lo schema va esposto in Dashboard → Settings → API → Exposed schemas.
NEXT_PUBLIC_SUPABASE_URL=https://mjzjracjadlybvdttgto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key

# Server-only (Next.js server actions / route handlers). NEVER prefix with NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Optional — used for QR poster universal links (Cloudflare Worker URL)
# NEXT_PUBLIC_APP_URL=https://lobby-backoffice.example.workers.dev
