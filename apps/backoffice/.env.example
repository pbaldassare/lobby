# Public (safe for browser bundle — anon key is RLS-gated)
# Copy to .env.local and fill from Supabase Dashboard → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key

# Server-only (Next.js server actions / route handlers). NEVER prefix with NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Optional — used for QR poster universal links
# NEXT_PUBLIC_APP_URL=https://backoffice.example.com
