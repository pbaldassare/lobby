{
  "name": "@lobby/backoffice",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --port 3000",
    "build": "next build",
    "cf:build": "opennextjs-cloudflare build && node ../../scripts/cf-pages-stage.mjs",
    "start": "next start --port 3000",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "npm run cf:build && wrangler pages deploy .pages-dist --project-name lobby",
    "upload": "npm run cf:build && wrangler pages deploy .pages-dist --project-name lobby",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@lobby/shared": "*",
    "@opennextjs/cloudflare": "^1.20.6",
    "@supabase/ssr": "^0.6.1",
    "@supabase/supabase-js": "^2.53.0",
    "next": "^16.2.12",
    "qrcode": "^1.5.4",
    "react": "19.2.3",
    "react-dom": "19.2.3"
  },
  "devDependencies": {
    "@types/node": "^22.16.5",
    "@types/qrcode": "^1.5.5",
    "@types/react": "~19.2.2",
    "@types/react-dom": "~19.2.2",
    "eslint-config-next": "^16.3.3",
    "typescript": "^5.8.3",
    "wrangler": "^4.131.1"
  }
}
