{
  "name": "lobby",
  "private": true,
  "version": "0.0.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "mobile": "npm run start --workspace=@lobby/mobile",
    "backoffice": "npm run dev --workspace=@lobby/backoffice",
    "build": "npm run cf:build --workspace=@lobby/backoffice",
    "deploy": "npm run deploy --workspace=@lobby/backoffice",
    "lint": "eslint .",
    "format": "prettier --write .",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "devDependencies": {
    "@next/eslint-plugin-next": "^16.3.3",
    "@typescript-eslint/eslint-plugin": "^8.38.0",
    "@typescript-eslint/parser": "^8.38.0",
    "eslint": "^9.32.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.6.2",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">=20"
  }
}
