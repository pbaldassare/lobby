{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "rootDir": "./src",
    "outDir": "./dist",
    "noEmit": true,
    "jsx": "react-jsx",
    "lib": ["ES2022"],
    "types": ["react"]
  },
  "include": [
    "src/index.ts",
    "src/tokens/**/*",
    "src/types/**/*",
    "src/supabase/**/*"
  ],
  "exclude": ["src/ui/**/*"]
}
